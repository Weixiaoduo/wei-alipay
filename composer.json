{
    "name": "weixiaoduo/woo-alipay",
    "description": "WooCommerce Alipay gateway",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "php-stubs/woocommerce-stubs": "10.2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=4G"
    },
    "config": {
        "sort-packages": true
    }
}
